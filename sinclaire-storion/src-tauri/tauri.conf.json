{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sinclaire Storion",
  "version": "0.1.0",
  "identifier": "studios.sinclairesebastian.storion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sinclaire Storion",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sinclaire Sebastian Studios",
    "copyright": "© Sinclaire Sebastian Studios. Made by Sseruwagi Sinclaire Sebastian.",
    "category": "Productivity",
    "shortDescription": "Director-first storyboard workspace",
    "longDescription": "Sinclaire Storion is a director-first visual planning workspace for storyboarding, shot design, and pre-production. Property of Sinclaire Sebastian Studios.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
